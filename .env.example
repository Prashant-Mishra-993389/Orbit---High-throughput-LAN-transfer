# ShareLAN Network & Server Configuration
PORT=37821
HOST=0.0.0.0
NODE_ENV=development

# Storage Directories
# On Windows, defaults to %USERPROFILE%\Downloads\ShareLAN if not set
DOWNLOAD_DIRECTORY=
TEMP_DIRECTORY=

# Transfer Engine Defaults
# 64 MiB default chunk size (67108864 bytes)
CHUNK_SIZE=67108864
MAX_CONCURRENT_TRANSFERS=4
TRANSFER_TIMEOUT_MS=300000

# Security
PAIRING_TOKEN_TTL_MS=300000
MAX_FILE_SIZE_BYTES=107374182400

# Logging
LOG_LEVEL=info
